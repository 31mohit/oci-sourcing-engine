# Example Terraform variables
# Copy this file to terraform.tfvars and populate with your actual values.
# Note: terraform.tfvars contains sensitive values and is gitignored.

tenancy_ocid       = "ocid1.tenancy.oc1..exampleuniqueID"
allowed_cidr       = "203.0.113.10/32"
ssh_public_key     = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPlaceholderKeyForDocumentationOnly user@example"
instance_ocpus     = 2
instance_memory_gb = 12
fault_domain       = null
